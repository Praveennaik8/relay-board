rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function boardPath(boardId) {
      return /databases/$(database)/documents/workspaces/$(boardId);
    }
    function memberPath(boardId, userId) {
      return /databases/$(database)/documents/workspaces/$(boardId)/members/$(userId);
    }
    function accessPath(boardId) {
      return /databases/$(database)/documents/workspaces/$(boardId)/_private/access;
    }
    function userMembershipPath(boardId, userId) {
      return /databases/$(database)/documents/users/$(userId)/boardMemberships/$(boardId);
    }
    function postPath(boardId, postId) {
      return /databases/$(database)/documents/workspaces/$(boardId)/posts/$(postId);
    }
    function actionPath(boardId, postId) {
      return /databases/$(database)/documents/workspaces/$(boardId)/posts/$(postId)/actions/$(request.auth.uid);
    }
    function isMember(boardId) {
      return signedIn() && exists(memberPath(boardId, request.auth.uid));
    }
    function validOwnerMember(member, userId) {
      return member.keys().hasOnly(['userId', 'name', 'photoURL', 'role', 'joinedAt'])
        && member.userId == userId
        && member.name is string && member.name.size() > 0 && member.name.size() <= 80
        && (member.photoURL == null || member.photoURL is string)
        && member.role == 'owner'
        && member.joinedAt == request.time;
    }
    function validInitialUserMembership(membership, boardId, userId) {
      return membership.keys().hasOnly(['boardId', 'role', 'joinedAt'])
        && membership.boardId == boardId
        && membership.role == 'owner'
        && membership.joinedAt == request.time;
    }
    function validAccessCode(access) {
      return access.keys().hasOnly(['accessCode', 'createdAt'])
        && access.accessCode is string && access.accessCode.size() >= 6 && access.accessCode.size() <= 128
        && access.createdAt == request.time;
    }
    function validBoardCreation(boardId) {
      return request.resource.data.keys().hasOnly(['name', 'createdByName', 'createdAt', 'memberCount'])
        && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 80
        && request.resource.data.createdByName is string && request.resource.data.createdByName.size() > 0 && request.resource.data.createdByName.size() <= 80
        && request.resource.data.createdAt == request.time
        && request.resource.data.memberCount == 1
        && validOwnerMember(getAfter(memberPath(boardId, request.auth.uid)).data, request.auth.uid)
        && validAccessCode(getAfter(accessPath(boardId)).data)
        && validInitialUserMembership(getAfter(userMembershipPath(boardId, request.auth.uid)).data, boardId, request.auth.uid);
    }
    function validJoinRequest(requestData, userId) {
      return requestData.keys().hasOnly(['userId', 'name', 'photoURL', 'accessCode', 'requestedAt'])
        && requestData.userId == userId
        && requestData.name is string && requestData.name.size() > 0 && requestData.name.size() <= 80
        && (requestData.photoURL == null || requestData.photoURL is string)
        && requestData.accessCode is string && requestData.accessCode.size() >= 6 && requestData.accessCode.size() <= 128
        && requestData.requestedAt == request.time;
    }
    function validAuthor(author) {
      return author.keys().hasOnly(['uid', 'name', 'photoURL'])
        && author.uid == request.auth.uid
        && author.name is string
        && (author.photoURL == null || author.photoURL is string);
    }
    function validCounts(counts) {
      return counts.keys().hasOnly(['helpful', 'affected', 'join', 'acknowledge', 'claim', 'vote'])
        && counts.helpful is int && counts.helpful >= 0
        && counts.affected is int && counts.affected >= 0
        && counts.join is int && counts.join >= 0
        && counts.acknowledge is int && counts.acknowledge >= 0
        && counts.claim is int && counts.claim >= 0
        && counts.vote is int && counts.vote >= 0;
    }
    function validPostType(type) {
      return type in ['issue', 'activity', 'tip', 'announcement', 'lost-found', 'poll'];
    }
    function validExpiration(expiresAt) {
      return expiresAt == null || (expiresAt is timestamp && expiresAt > request.time);
    }
    function validNewPost() {
      return request.resource.data.keys().hasOnly(['type', 'title', 'description', 'author', 'actionCounts', 'totalActionCount', 'createdAt', 'updatedAt', 'expiresAt'])
        && request.resource.data.keys().hasAll(['expiresAt'])
        && validPostType(request.resource.data.type)
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 120
        && request.resource.data.description is string && request.resource.data.description.size() > 0 && request.resource.data.description.size() <= 2000
        && validAuthor(request.resource.data.author)
        && validCounts(request.resource.data.actionCounts)
        && request.resource.data.actionCounts.helpful == 0 && request.resource.data.actionCounts.affected == 0
        && request.resource.data.actionCounts.join == 0 && request.resource.data.actionCounts.acknowledge == 0
        && request.resource.data.actionCounts.claim == 0 && request.resource.data.actionCounts.vote == 0
        && request.resource.data.totalActionCount == 0
        && validExpiration(request.resource.data.expiresAt)
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
    }
    function validContentUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['type', 'title', 'description', 'updatedAt'])
        && validPostType(request.resource.data.type)
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 120
        && request.resource.data.description is string && request.resource.data.description.size() > 0 && request.resource.data.description.size() <= 2000
        && request.resource.data.updatedAt == request.time;
    }
    function matchingAction(type, action) {
      return (type == 'issue' && action in ['helpful', 'affected'])
        || (type == 'activity' && action == 'join')
        || (type == 'tip' && action == 'helpful')
        || (type == 'announcement' && action == 'acknowledge')
        || (type == 'lost-found' && action == 'claim')
        || (type == 'poll' && action == 'vote');
    }
    function onlyCounterChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['actionCounts', 'totalActionCount', 'updatedAt'])
        && validCounts(resource.data.actionCounts) && validCounts(request.resource.data.actionCounts)
        && request.resource.data.totalActionCount == resource.data.totalActionCount + 1
        && request.resource.data.updatedAt == request.time;
    }
    function countForActionIsIncremented(action) {
      return (action == 'helpful' && request.resource.data.actionCounts.helpful == resource.data.actionCounts.helpful + 1 && request.resource.data.actionCounts.affected == resource.data.actionCounts.affected && request.resource.data.actionCounts.join == resource.data.actionCounts.join && request.resource.data.actionCounts.acknowledge == resource.data.actionCounts.acknowledge && request.resource.data.actionCounts.claim == resource.data.actionCounts.claim && request.resource.data.actionCounts.vote == resource.data.actionCounts.vote)
        || (action == 'affected' && request.resource.data.actionCounts.helpful == resource.data.actionCounts.helpful && request.resource.data.actionCounts.affected == resource.data.actionCounts.affected + 1 && request.resource.data.actionCounts.join == resource.data.actionCounts.join && request.resource.data.actionCounts.acknowledge == resource.data.actionCounts.acknowledge && request.resource.data.actionCounts.claim == resource.data.actionCounts.claim && request.resource.data.actionCounts.vote == resource.data.actionCounts.vote)
        || (action == 'join' && request.resource.data.actionCounts.helpful == resource.data.actionCounts.helpful && request.resource.data.actionCounts.affected == resource.data.actionCounts.affected && request.resource.data.actionCounts.join == resource.data.actionCounts.join + 1 && request.resource.data.actionCounts.acknowledge == resource.data.actionCounts.acknowledge && request.resource.data.actionCounts.claim == resource.data.actionCounts.claim && request.resource.data.actionCounts.vote == resource.data.actionCounts.vote)
        || (action == 'acknowledge' && request.resource.data.actionCounts.helpful == resource.data.actionCounts.helpful && request.resource.data.actionCounts.affected == resource.data.actionCounts.affected && request.resource.data.actionCounts.join == resource.data.actionCounts.join && request.resource.data.actionCounts.acknowledge == resource.data.actionCounts.acknowledge + 1 && request.resource.data.actionCounts.claim == resource.data.actionCounts.claim && request.resource.data.actionCounts.vote == resource.data.actionCounts.vote)
        || (action == 'claim' && request.resource.data.actionCounts.helpful == resource.data.actionCounts.helpful && request.resource.data.actionCounts.affected == resource.data.actionCounts.affected && request.resource.data.actionCounts.join == resource.data.actionCounts.join && request.resource.data.actionCounts.acknowledge == resource.data.actionCounts.acknowledge && request.resource.data.actionCounts.claim == resource.data.actionCounts.claim + 1 && request.resource.data.actionCounts.vote == resource.data.actionCounts.vote)
        || (action == 'vote' && request.resource.data.actionCounts.helpful == resource.data.actionCounts.helpful && request.resource.data.actionCounts.affected == resource.data.actionCounts.affected && request.resource.data.actionCounts.join == resource.data.actionCounts.join && request.resource.data.actionCounts.acknowledge == resource.data.actionCounts.acknowledge && request.resource.data.actionCounts.claim == resource.data.actionCounts.claim && request.resource.data.actionCounts.vote == resource.data.actionCounts.vote + 1);
    }
    function validActionCounterUpdate(boardId, postId) {
      let afterAction = getAfter(actionPath(boardId, postId));
      return !exists(actionPath(boardId, postId))
        && afterAction.data.userId == request.auth.uid
        && matchingAction(resource.data.type, afterAction.data.actionType)
        && onlyCounterChanged()
        && countForActionIsIncremented(afterAction.data.actionType);
    }

    match /users/{userId}/boardMemberships/{boardId} {
      allow read: if signedIn() && userId == request.auth.uid;
      allow create: if signedIn() && userId == request.auth.uid
        && !exists(boardPath(boardId))
        && validInitialUserMembership(request.resource.data, boardId, userId)
        && getAfter(boardPath(boardId)).data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /workspaces/{boardId} {
      // The board document deliberately contains only directory-safe metadata.
      allow get, list: if signedIn();
      allow create: if signedIn() && validBoardCreation(boardId);
      allow update, delete: if false;

      match /_private/access {
        allow create: if signedIn() && !exists(boardPath(boardId))
          && validAccessCode(request.resource.data)
          && getAfter(boardPath(boardId)).data.createdAt == request.time
          && validOwnerMember(getAfter(memberPath(boardId, request.auth.uid)).data, request.auth.uid)
          && validInitialUserMembership(getAfter(userMembershipPath(boardId, request.auth.uid)).data, boardId, request.auth.uid);
        allow read, update, delete: if false;
      }

      match /members/{userId} {
        // This enables a signed-in user to determine only their own memberships.
        allow get, list: if signedIn() && userId == request.auth.uid;
        allow create: if signedIn() && userId == request.auth.uid
          && !exists(boardPath(boardId))
          && validOwnerMember(request.resource.data, userId)
          && getAfter(boardPath(boardId)).data.createdAt == request.time
          && validAccessCode(getAfter(accessPath(boardId)).data)
          && validInitialUserMembership(getAfter(userMembershipPath(boardId, userId)).data, boardId, userId);
        allow update, delete: if false;
      }

      match /joinRequests/{userId} {
        allow create: if signedIn() && userId == request.auth.uid
          && exists(boardPath(boardId))
          && exists(accessPath(boardId))
          && !exists(memberPath(boardId, userId))
          && validJoinRequest(request.resource.data, userId)
          && request.resource.data.accessCode == get(accessPath(boardId)).data.accessCode;
        allow read, update, delete: if false;
      }

      match /posts/{postId} {
        allow read: if isMember(boardId);
        allow create: if isMember(boardId) && validNewPost();
        allow update: if isMember(boardId) && ((resource.data.author.uid == request.auth.uid && validContentUpdate()) || validActionCounterUpdate(boardId, postId));
        allow delete: if isMember(boardId) && resource.data.author.uid == request.auth.uid;

        match /actions/{userId} {
          allow read: if isMember(boardId) && exists(postPath(boardId, postId));
          allow create: if isMember(boardId) && userId == request.auth.uid
            && request.resource.data.keys().hasOnly(['actionType', 'userId', 'createdAt'])
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.createdAt == request.time
            && matchingAction(get(postPath(boardId, postId)).data.type, request.resource.data.actionType)
            && getAfter(postPath(boardId, postId)).data.totalActionCount == get(postPath(boardId, postId)).data.totalActionCount + 1;
          allow update, delete: if false;
        }

        match /comments/{commentId} {
          allow read: if isMember(boardId) && exists(postPath(boardId, postId));
          allow create: if isMember(boardId) && exists(postPath(boardId, postId))
            && request.resource.data.keys().hasOnly(['text', 'author', 'createdAt'])
            && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000
            && validAuthor(request.resource.data.author)
            && request.resource.data.createdAt == request.time;
          allow delete: if isMember(boardId) && resource.data.author.uid == request.auth.uid;
          allow update: if false;
        }
      }
    }
  }
}
